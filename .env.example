# URL base da API.
#
# Em desenvolvimento deixe comentada/vazia: o cliente cai em "/api" e o proxy
# do Vite (vite.config.ts) repassa para o backend em http://localhost:8080,
# contornando o CORS que o backend ainda não publica.
#
# Em produção aponte para a URL real da API.
# VITE_API_URL=https://api.exemplo.com.br
